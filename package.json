{
  "name": "par-dots",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4231 --strictPort",
    "build": "bun run scripts/build-library.ts && vite build",
    "preview": "vite preview --port 4231 --strictPort",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fmt": "biome format --write .",
    "icons": "bun run scripts/build-icons.ts",
    "e2e": "bun run scripts/e2e-smoke.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "26.6.3",
    "@vitest/coverage-v8": "5.0.2",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.14.5",
    "playwright": "1.63.0",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.2",
    "workbox-window": "7.4.1"
  }
}
